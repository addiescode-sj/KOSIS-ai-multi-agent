# Copy to .env and fill in. Never commit .env.
# Phase 3 entry points (backend, evals, scripts) load this .env at start; shell values win (`set X=...` overrides one run).
# Phase 1 / 2 modules never read it: they get settings objects. docker compose passes it as env_file. Names: backend/app/config.py.
# HCX (HyperCLOVA X). CLOVA Studio API key (starts with nv-): phase 1 answers and the hcx / clova stage 2.
HCX_API_KEY=
# Phase 1 model (default hcx HCX-DASH-002); mock = offline tests and pre-runs
# STAT_PROVIDER=hcx
# STAT_MODEL=HCX-DASH-002
# STAT_RETRY_INTERVAL=0
# KOSIS OpenAPI
KOSIS_API_KEY=
# PostgreSQL + pgvector (docker compose service `postgres`): conversations and the vector store (T3-47, was ChromaDB).
# Host-side address for scripts and tests; inside compose the backend uses postgres:5432 (set in docker-compose.yml).
# DATABASE_URL=postgresql+psycopg://kosis:kosis@localhost:5432/kosis
# Service API (T3-51, docs/service/api.md). With DATABASE_URL the conversation state, sessions and feedback are in PostgreSQL.
# KOSIS_DISABLE_DEV_ROUTES=1        # deployment: /dev/* and the old /tools/*, /threads/*, POST /chat answer 404
# KOSIS_SHUTDOWN_TIMEOUT=25         # seconds running answers get on SIGTERM; keep it under the pod's grace period (30)
# KOSIS_SESSION_TTL_MINUTES=60      # guest conversation expiry (PL-BIWRBV)
# KOSIS_LOG_RETENTION_DAYS=90       # raw text kept this long; run `python -m kosis_store.cleanup` daily
# Jaeger tracing for eval runs (T2-15). Start with `docker compose --profile obs up -d jaeger`; unset = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# JAEGER_UI_URL=http://localhost:16686
# Phase 2 search (kosis_rag.api.SearchModule; values: vendor/phase2/docs/config.md). Weights are not in git: data/models/.
# Data files are read from <KOSIS_WORKSPACE>/data (tables.jsonl, sigungu.json, hq/). Checkpoint paths as given (cwd).
# VECTOR_COLLECTION=kosis_a_bgeft_<version>   # was CHROMA_COLLECTION (same name). list: python -m kosis_rag_build.cli vectors --list
# Moving an old Chroma volume without re-embedding: vendor/phase2/docs/migration.md "T2-44" (scripts/chroma_to_pgvector.py)
# EMBED_CKPT=data/models/embedder/bge-m3-ft-unseen-e1.pt   # data/models/MODELS.md
# RERANK_CKPT=data/models/reranker/bge-reranker-v2-m3-ft-unseen-e2.pt   # empty = no stage 1
# Deploy: query embedder / stage 1 on the inference servers (inference/README.md). Set both URLs and the
# backend loads neither model; build it without torch with BACKEND_WITH_EMBED=0 (docker compose reads it here).
# EMBED_URL=http://<inference host>:8001
# RERANK_URL=http://<inference host>:8002
# BACKEND_WITH_EMBED=0
# RERANK_MODE=blend   # blend | score
# STAGE2=clova        # clova | none (uses HCX_API_KEY)
# STAGE2_MAX_TOKENS=  # stage 2 output cap; empty = phase 2 default (gpt: 512). A thinking model (Qwen 3.8 low..xhigh) needs e.g. 16384
# INTERPRETER_MODEL=stage2   # follow-up reader / multi-query splitter on the STAGE2_* server (self-hosted Qwen); default gpt-4o-mini
HQ_BUILD=
OPENAI_API_KEY=
# COND_FILTER=on      # on | off: T2-14 conditions before the hybrid
# COND_SCOPE=years    # all (default) | years: only the years / period range filter (KOS-192 best L1)
# TEXT_FORMAT=n2-L60  # optional check; the collection records its table text
# ANSWER_K=5
# HQ_BUILD=          # empty = reverse HyDE question index off (default)
# Kakao login (T3-54, docs/service/api.md 6): REST API key and client secret of the Kakao app. Empty = login off, guests only.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# Address the browser returns to (the frontend); register the same text in the Kakao console. https makes cookies Secure.
# KAKAO_REDIRECT_URI=http://localhost:3000/auth/kakao/callback
# Kakao's addresses (change them for a test server) and time limits in whole seconds: each call to Kakao, finishing Kakao's screens.
# KAKAO_AUTHORIZE_URL=https://kauth.kakao.com/oauth/authorize
# KAKAO_TOKEN_URL=https://kauth.kakao.com/oauth/token
# KAKAO_ME_URL=https://kapi.kakao.com/v2/user/me
# KAKAO_TIMEOUT_SECONDS=5
# KAKAO_STATE_TTL_SECONDS=600
