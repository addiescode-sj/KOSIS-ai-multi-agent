# Copy to .env and fill in. Never commit .env.
# Phase 3 entry points (backend, evals, scripts) load this .env at start; shell values win (`set X=...` overrides one run).
# Phase 1 / 2 modules never read it: they get settings objects. docker compose passes it as env_file. Names: backend/app/config.py.
# HCX (HyperCLOVA X). CLOVA Studio API key (starts with nv-): phase 1 answers and the hcx / clova stage 2.
HCX_API_KEY=
# Phase 1 model (default hcx HCX-DASH-002); mock = offline tests and pre-runs
# STAT_PROVIDER=hcx
# STAT_MODEL=HCX-DASH-002
# STAT_RETRY_INTERVAL=0
# KOSIS OpenAPI
KOSIS_API_KEY=
# ChromaDB (docker compose service `chroma`, T2-23). Host-side address for notebooks, scripts and tests.
# Inside compose the backend uses chroma:8000 (set in docker-compose.yml). Change CHROMA_PORT if 8001 is taken.
CHROMA_HOST=localhost
CHROMA_PORT=8001
# Jaeger tracing for eval runs (T2-15). Start with `docker compose --profile obs up -d jaeger`; unset = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# JAEGER_UI_URL=http://localhost:16686
# Phase 2 search (kosis_rag.api.SearchModule; values: vendor/phase2/docs/config.md). Weights are not in git: data/models/.
# Data files are read from <KOSIS_WORKSPACE>/data (tables.jsonl, sigungu.json, hq/). Checkpoint paths as given (cwd).
# CHROMA_COLLECTION=kosis_a_bgeft_<version>   # list: python -m kosis_rag_build.cli chroma --list --chroma-host localhost --chroma-port 8001
# EMBED_CKPT=data/models/embedder/bge-m3-ft-unseen-e1.pt   # data/models/MODELS.md
# RERANK_CKPT=data/models/reranker/bge-reranker-v2-m3-ft-unseen-e2.pt   # empty = no stage 1
# RERANK_MODE=blend   # blend | score
# STAGE2=clova        # clova | none (uses HCX_API_KEY)
HQ_BUILD=
OPENAI_API_KEY=
# COND_FILTER=on      # on | off: T2-14 conditions before the hybrid
# TEXT_FORMAT=n2-L60  # optional check; the collection records its table text
# ANSWER_K=5
# HQ_BUILD=          # empty = reverse HyDE question index off (default)
