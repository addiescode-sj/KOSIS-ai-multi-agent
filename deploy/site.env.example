# 서버마다 다른 값. cp site.env.example site.env 후 채운다. site.env 는 git에 올리지 않는다(.gitignore).
# 고친 뒤: bash scripts/05-make-site.sh  (k8s 덧씌우기 다시 만들기)
SITE_HOST=          # 사이트 주소(호스트 이름만). 예: 1-2-3-4.sslip.io = node-1 고정 IP 1.2.3.4
GPU_IP=             # GPU 서버 내부(사설) IP. CPU 서버에서 8000(vLLM)·8002(임베딩)·8003(리랭커)로 부른다
